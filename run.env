# zen-mcp run configuration (loaded by zen-run, see `run.sh --config`)
BIN=zen-mcp
PKG=.
BUILD_TAGS=fts5

# no fixed args; `run.sh -- <extra>` passes them straight through
RUN_ARGS=""

# refuse to start from a directory without the app config
RUN_REQUIRE="config.json"

RUN_WATCH_EXCLUDE_DIR="assets tmp npm vendor build frontend/node_modules internal/cfg/data .git"
RUN_WATCH_EXCLUDE_FILE="yaml"
RUN_WATCH_EXCLUDE_REGEX='_test\.go'
RUN_WATCH_DELAY_MS=4000
RUN_WATCH_POLL_MS=1000
